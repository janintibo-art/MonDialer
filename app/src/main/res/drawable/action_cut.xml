<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="270"
                android:startColor="?attr/cButtonEnd"
                android:centerColor="?attr/cPanelEnd"
                android:endColor="?attr/cButtonStart" />
            <corners android:topLeftRadius="14dp" android:topRightRadius="3dp"
                android:bottomLeftRadius="3dp" android:bottomRightRadius="14dp" />
            <stroke android:width="2dp" android:color="?attr/cAccent2" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp"><shape>
                <solid android:color="#76000000" />
                <corners android:topLeftRadius="14dp" android:topRightRadius="3dp"
                    android:bottomLeftRadius="3dp" android:bottomRightRadius="14dp" />
            </shape></item>
            <item android:bottom="4dp"><shape>
                <gradient android:angle="90"
                    android:startColor="?attr/cButtonStart"
                    android:centerColor="?attr/cPanelEnd"
                    android:endColor="?attr/cButtonEnd" />
                <corners android:topLeftRadius="14dp" android:topRightRadius="3dp"
                    android:bottomLeftRadius="3dp" android:bottomRightRadius="14dp" />
                <stroke android:width="1.4dp" android:color="?attr/cNeonDim" />
            </shape></item>
            <!-- Trait d'accent en bas -->
            <item android:bottom="4dp" android:top="40dp" android:left="10dp" android:right="10dp">
                <shape>
                    <solid android:color="?attr/cHaloStrong" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
