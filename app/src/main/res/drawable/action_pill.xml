<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape>
                <gradient android:type="radial" android:gradientRadius="90dp"
                    android:startColor="?attr/cHaloStrong" android:endColor="#00000000" />
                <corners android:radius="26dp" />
            </shape></item>
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#0E2A3C" android:endColor="#030608" />
                    <corners android:radius="26dp" />
                    <stroke android:width="2dp" android:color="?attr/cNeon" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape>
                <corners android:radius="26dp" />
                <stroke android:width="4dp" android:color="?attr/cHalo" />
            </shape></item>
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape>
                    <gradient android:angle="90"
                        android:startColor="#02040A"
                        android:centerColor="#06121E"
                        android:endColor="#0B1E2D" />
                    <corners android:radius="26dp" />
                    <stroke android:width="1.6dp" android:color="?attr/cNeon" />
                </shape>
            </item>
            <item android:top="3dp" android:bottom="26dp" android:left="7dp" android:right="7dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#3DFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
