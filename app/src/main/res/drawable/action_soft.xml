<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="270"
                android:startColor="?attr/cButtonEnd"
                android:centerColor="?attr/cPanelEnd"
                android:endColor="?attr/cButtonStart" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="?attr/cAccent2" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp"><shape>
                <solid android:color="#76000000" /><corners android:radius="14dp" />
            </shape></item>
            <item android:bottom="4dp"><shape>
                <gradient android:angle="90"
                    android:startColor="?attr/cButtonStart"
                    android:centerColor="?attr/cPanelEnd"
                    android:endColor="?attr/cButtonEnd" />
                <corners android:radius="14dp" />
                <stroke android:width="1.6dp" android:color="?attr/cNeonDim" />
            </shape></item>
            <item android:bottom="4dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#42FFFFFF"
                        android:centerColor="#12FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
