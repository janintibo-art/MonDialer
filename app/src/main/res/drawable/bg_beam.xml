<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape>
        <gradient android:angle="315"
            android:startColor="?attr/cBgStart"
            android:centerColor="?attr/cBgMid"
            android:endColor="?attr/cBgEnd" />
    </shape></item>
    <!-- Faisceau lumineux oblique -->
    <item><shape>
        <gradient android:angle="45"
            android:startColor="#00000000"
            android:centerColor="?attr/cHalo"
            android:endColor="#00000000" />
    </shape></item>
    <!-- Bandeau supérieur -->
    <item android:bottom="500dp"><shape>
        <gradient android:angle="270"
            android:startColor="?attr/cHaloAlt" android:endColor="#00000000" />
    </shape></item>
    <!-- Liseré de base -->
    <item android:top="640dp"><shape>
        <gradient android:angle="90"
            android:startColor="?attr/cHaloStrong" android:endColor="#00000000" />
    </shape></item>
</layer-list>
