<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="#03050A" /></shape></item>
    <item><shape>
        <gradient android:angle="315"
            android:startColor="#00000000"
            android:centerColor="?attr/cBgMid"
            android:endColor="#00000000" />
    </shape></item>
    <item><shape><solid android:color="#C4000000" /></shape></item>
    <!-- Faisceau oblique doux, sans bord -->
    <item><shape>
        <gradient android:angle="45"
            android:startColor="#00000000"
            android:centerColor="?attr/cHalo"
            android:endColor="#00000000" />
    </shape></item>
    <!-- Lueur haute -->
    <item><shape>
        <gradient android:type="radial" android:gradientRadius="60%p"
            android:centerX="0.3" android:centerY="0.02"
            android:startColor="?attr/cHalo" android:endColor="#00000000" />
    </shape></item>
</layer-list>
