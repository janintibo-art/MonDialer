<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="#03050A" /></shape></item>
    <!-- Teinte diagonale très atténuée, pleine surface -->
    <item><shape>
        <gradient android:angle="135"
            android:startColor="#00000000"
            android:centerColor="?attr/cBgMid"
            android:endColor="#00000000" />
    </shape></item>
    <item><shape><solid android:color="#B8000000" /></shape></item>
    <!-- Lueur haute : radial pleine surface, aucun bord franc -->
    <item><shape>
        <gradient android:type="radial" android:gradientRadius="70%p"
            android:centerX="0.5" android:centerY="0.04"
            android:startColor="?attr/cHalo" android:endColor="#00000000" />
    </shape></item>
    <!-- Lueur basse, même teinte pour rester monochrome -->
    <item><shape>
        <gradient android:type="radial" android:gradientRadius="55%p"
            android:centerX="0.5" android:centerY="1.0"
            android:startColor="?attr/cHalo" android:endColor="#00000000" />
    </shape></item>
</layer-list>
