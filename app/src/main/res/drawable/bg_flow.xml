<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base quasi noire -->
    <item><shape><solid android:color="#03050A" /></shape></item>
    <!-- Teinte du thème très atténuée -->
    <item><shape>
        <gradient android:angle="135"
            android:startColor="#00000000"
            android:centerColor="?attr/cBgMid"
            android:endColor="#00000000" />
    </shape></item>
    <!-- Voile noir qui écrase la teinte -->
    <item><shape><solid android:color="#B3000000" /></shape></item>
    <!-- Lueur d'ambiance en haut -->
    <item android:bottom="420dp"><shape>
        <gradient android:type="radial" android:gradientRadius="480dp"
            android:centerX="0.5" android:centerY="0.02"
            android:startColor="?attr/cHalo" android:endColor="#00000000" />
    </shape></item>
    <!-- Lueur basse -->
    <item android:top="520dp"><shape>
        <gradient android:type="radial" android:gradientRadius="420dp"
            android:centerX="0.5" android:centerY="1.0"
            android:startColor="?attr/cHaloAlt" android:endColor="#00000000" />
    </shape></item>
</layer-list>
