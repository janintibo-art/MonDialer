<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:startColor="#03050C"
                android:centerColor="#0B1B2B"
                android:endColor="#03050C"
                android:angle="135" />
        </shape>
    </item>
    <item android:bottom="400dp">
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:centerX="0.5" android:centerY="0"
                android:startColor="?attr/cHalo"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
