<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="#04060B" /></shape></item>
    <item><shape>
        <gradient android:type="radial" android:gradientRadius="600dp"
            android:centerX="0.5" android:centerY="0.40"
            android:startColor="?attr/cBgMid" android:endColor="#00000000" />
    </shape></item>
    <item><shape><solid android:color="#BF000000" /></shape></item>
    <item><shape>
        <gradient android:type="radial" android:gradientRadius="560dp"
            android:centerX="0.5" android:centerY="0.38"
            android:startColor="?attr/cHalo" android:endColor="#00000000" />
    </shape></item>
    <!-- Vignette : bords très sombres -->
    <item><shape>
        <gradient android:type="radial" android:gradientRadius="700dp"
            android:centerX="0.5" android:centerY="0.5"
            android:startColor="#00000000" android:endColor="#99000000" />
    </shape></item>
</layer-list>
