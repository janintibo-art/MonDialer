<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape>
        <gradient android:angle="90"
            android:startColor="?attr/cBgEnd"
            android:centerColor="?attr/cBgMid"
            android:endColor="?attr/cBgStart" />
    </shape></item>
    <!-- Lueur centrale large -->
    <item><shape>
        <gradient android:type="radial" android:gradientRadius="620dp"
            android:centerX="0.5" android:centerY="0.42"
            android:startColor="?attr/cHalo" android:endColor="#00000000" />
    </shape></item>
    <!-- Assombrissement des bords (vignette) -->
    <item><shape>
        <gradient android:type="radial" android:gradientRadius="700dp"
            android:centerX="0.5" android:centerY="0.5"
            android:startColor="#00000000" android:endColor="#66000000" />
    </shape></item>
</layer-list>
