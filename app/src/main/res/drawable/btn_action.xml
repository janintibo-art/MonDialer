<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/neon_dim" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="@color/neon" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/panel" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="@color/neon_dim" />
        </shape>
    </item>
</selector>
