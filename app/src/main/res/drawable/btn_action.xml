<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#0A1420" android:endColor="#1E4A63" />
                    <corners android:radius="24dp" />
                    <stroke android:width="1.5dp" android:color="@color/neon" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Ombre portée basse -->
            <item android:top="3dp">
                <shape>
                    <solid android:color="#66000000" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <!-- Plaque avec relief -->
            <item android:bottom="3dp">
                <shape>
                    <gradient android:angle="90"
                        android:startColor="#0C1B2A" android:endColor="#1A3D52" />
                    <corners android:radius="24dp" />
                    <stroke android:width="1dp" android:color="@color/neon_dim" />
                </shape>
            </item>
            <!-- Liseré lumineux supérieur -->
            <item android:bottom="3dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#2EFFFFFF" android:centerColor="#00FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
