<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#00A868" android:endColor="#00FF9C" />
                    <corners android:radius="32dp" />
                    <stroke android:width="2dp" android:color="#B3FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Halo vert -->
            <item>
                <shape>
                    <gradient android:type="radial" android:gradientRadius="140dp"
                        android:startColor="#4D00FF9C" android:endColor="#0000FF9C" />
                    <corners android:radius="36dp" />
                </shape>
            </item>
            <!-- Corps bombé -->
            <item android:top="4dp" android:bottom="6dp" android:left="4dp" android:right="4dp">
                <shape>
                    <gradient android:angle="90"
                        android:startColor="#00B26E" android:endColor="#00FF9C" />
                    <corners android:radius="30dp" />
                </shape>
            </item>
            <!-- Reflet -->
            <item android:top="5dp" android:bottom="30dp" android:left="14dp" android:right="14dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#59FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
