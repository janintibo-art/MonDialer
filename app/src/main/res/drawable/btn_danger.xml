<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:type="radial" android:gradientRadius="140dp"
                android:startColor="#4DFF3D71" android:endColor="#00FF3D71" />
            <corners android:radius="36dp" />
        </shape>
    </item>
    <item android:top="4dp" android:bottom="6dp" android:left="4dp" android:right="4dp">
        <shape>
            <gradient android:angle="90"
                android:startColor="#C22550" android:endColor="#FF3D71" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:top="5dp" android:bottom="30dp" android:left="14dp" android:right="14dp">
        <shape>
            <gradient android:angle="270"
                android:startColor="#4DFFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
