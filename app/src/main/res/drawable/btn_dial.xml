<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- Halo intensifié -->
            <item>
                <shape android:shape="oval">
                    <gradient android:type="radial" android:gradientRadius="46dp"
                        android:startColor="#8000E5FF" android:endColor="#0000E5FF" />
                </shape>
            </item>
            <!-- Dôme enfoncé : dégradé inversé (sombre en haut) -->
            <item android:top="7dp" android:bottom="7dp" android:left="7dp" android:right="7dp">
                <shape android:shape="oval">
                    <gradient android:angle="270"
                        android:startColor="#071019" android:endColor="#16394F" />
                    <stroke android:width="2dp" android:color="@color/neon" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Halo doux permanent -->
            <item>
                <shape android:shape="oval">
                    <gradient android:type="radial" android:gradientRadius="46dp"
                        android:startColor="#3300E5FF" android:endColor="#0000E5FF" />
                </shape>
            </item>
            <!-- Dôme en relief : clair en haut, sombre en bas -->
            <item android:top="7dp" android:bottom="7dp" android:left="7dp" android:right="7dp">
                <shape android:shape="oval">
                    <gradient android:angle="90"
                        android:startColor="#0A1622" android:endColor="#1B4258" />
                    <stroke android:width="1.5dp" android:color="@color/neon_dim" />
                </shape>
            </item>
            <!-- Reflet lumineux sur le dessus du dôme -->
            <item android:top="9dp" android:bottom="34dp" android:left="16dp" android:right="16dp">
                <shape android:shape="oval">
                    <gradient android:angle="270"
                        android:startColor="#3AFFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
