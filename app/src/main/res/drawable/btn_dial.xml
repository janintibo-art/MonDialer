<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient android:type="radial" android:gradientRadius="58dp"
                        android:startColor="?attr/cHaloStrong" android:endColor="#00000000" />
                </shape>
            </item>
            <item android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
                <shape android:shape="oval">
                    <gradient android:angle="270"
                        android:startColor="?attr/cDialEnd"
                        android:centerColor="?attr/cButtonEnd"
                        android:endColor="?attr/cDialStart" />
                    <stroke android:width="2.5dp" android:color="?attr/cAccent2" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient android:type="radial" android:gradientRadius="58dp"
                        android:startColor="?attr/cHalo" android:endColor="#00000000" />
                </shape>
            </item>
            <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
                <shape android:shape="oval">
                    <gradient android:angle="90"
                        android:startColor="?attr/cDialStart"
                        android:centerColor="?attr/cButtonStart"
                        android:endColor="?attr/cDialEnd" />
                    <stroke android:width="1.8dp" android:color="?attr/cNeonDim" />
                </shape>
            </item>
            <item android:top="8dp" android:bottom="30dp" android:left="15dp" android:right="15dp">
                <shape android:shape="oval">
                    <gradient android:angle="270"
                        android:startColor="#58FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
            <item android:top="12dp" android:bottom="12dp" android:left="12dp" android:right="12dp">
                <shape android:shape="oval">
                    <stroke android:width="1dp" android:color="#14FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
