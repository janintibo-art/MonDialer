<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="270"
                android:startColor="?attr/cCallEnd"
                android:centerColor="?attr/cNeon"
                android:endColor="?attr/cCallStart" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="4dp"
                android:bottomLeftRadius="4dp" android:bottomRightRadius="20dp" />
            <stroke android:width="2dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item><shape>
                <gradient android:type="radial" android:gradientRadius="160dp"
                    android:startColor="?attr/cCallHalo" android:endColor="#00000000" />
                <corners android:radius="22dp" />
            </shape></item>
            <item android:top="4dp" android:bottom="6dp" android:left="4dp" android:right="4dp">
                <shape>
                    <gradient android:angle="90"
                        android:startColor="?attr/cCallStart"
                        android:centerColor="?attr/cNeon"
                        android:endColor="?attr/cCallEnd" />
                    <corners android:topLeftRadius="20dp" android:topRightRadius="4dp"
                        android:bottomLeftRadius="4dp" android:bottomRightRadius="20dp" />
                    <stroke android:width="1.2dp" android:color="#99FFFFFF" />
                </shape>
            </item>
            <item android:top="5dp" android:bottom="30dp" android:left="12dp" android:right="12dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#70FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
