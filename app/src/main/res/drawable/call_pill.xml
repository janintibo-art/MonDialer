<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape>
                <gradient android:type="radial" android:gradientRadius="200dp"
                    android:startColor="?attr/cHaloStrong" android:endColor="#00000000" />
                <corners android:radius="34dp" />
            </shape></item>
            <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="?attr/cNeon" android:endColor="?attr/cNeonDim" />
                    <corners android:radius="30dp" />
                    <stroke android:width="2dp" android:color="#E6FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Double halo lumineux -->
            <item><shape>
                <corners android:radius="34dp" />
                <stroke android:width="7dp" android:color="?attr/cHalo" />
            </shape></item>
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape>
                    <corners android:radius="34dp" />
                    <stroke android:width="4dp" android:color="?attr/cHaloStrong" />
                </shape>
            </item>
            <!-- Corps néon -->
            <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
                <shape>
                    <gradient android:angle="90"
                        android:startColor="?attr/cNeonDim"
                        android:centerColor="?attr/cNeon"
                        android:endColor="?attr/cNeonDim" />
                    <corners android:radius="30dp" />
                    <stroke android:width="1.6dp" android:color="#CCFFFFFF" />
                </shape>
            </item>
            <!-- Reflet -->
            <item android:top="6dp" android:bottom="32dp" android:left="14dp" android:right="14dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#66FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
