<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape>
                <gradient android:angle="0"
                    android:startColor="?attr/cHaloStrong"
                    android:centerColor="?attr/cHalo"
                    android:endColor="#00000000" />
                <corners android:radius="14dp" />
            </shape></item>
            <item android:left="3dp">
                <shape>
                    <gradient android:angle="90"
                        android:startColor="#14293A" android:endColor="#0A1826" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1.4dp" android:color="?attr/cNeon" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Ombre douce sous la carte -->
            <item android:top="3dp"><shape>
                <solid android:color="#66000000" />
                <corners android:radius="14dp" />
            </shape></item>
            <!-- Corps de verre -->
            <item android:bottom="3dp"><shape>
                <gradient android:angle="90"
                    android:startColor="#070F1A"
                    android:centerColor="#0A1725"
                    android:endColor="#0D1E2E" />
                <corners android:radius="14dp" />
                <stroke android:width="1dp" android:color="#33FFFFFF" />
            </shape></item>
            <!-- Reflet supérieur -->
            <item android:bottom="26dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#1FFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <!-- Liseré d'accent sur le bord gauche : signature du thème -->
            <item android:right="0dp" android:bottom="3dp"><shape>
                <gradient android:angle="0"
                    android:startColor="?attr/cNeon"
                    android:centerColor="?attr/cHalo"
                    android:endColor="#00000000" />
                <corners android:radius="14dp" />
                <size android:width="4dp" />
            </shape></item>
        </layer-list>
    </item>
</selector>
