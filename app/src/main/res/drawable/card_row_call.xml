<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient android:angle="270" android:startColor="#26394B" android:endColor="#09131E" />
            <stroke android:width="1dp" android:color="#8294A6" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape><corners android:radius="17dp" /><solid android:color="#A9000000" /></shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <corners android:radius="17dp" />
                    <gradient android:angle="270" android:startColor="#1B2B3B"
                        android:centerColor="#101B29" android:endColor="#070D16" />
                    <stroke android:width="1dp" android:color="#547080" />
                </shape>
            </item>
            <item android:left="2dp" android:right="2dp" android:top="1dp" android:bottom="45dp">
                <shape>
                    <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" />
                    <gradient android:angle="270" android:startColor="#26FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
