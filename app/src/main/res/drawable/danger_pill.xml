<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape>
        <corners android:radius="34dp" />
        <stroke android:width="7dp" android:color="#33FF3D71" />
    </shape></item>
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape>
            <corners android:radius="34dp" />
            <stroke android:width="4dp" android:color="#66FF3D71" />
        </shape>
    </item>
    <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
        <shape>
            <gradient android:angle="90"
                android:startColor="?attr/cDangerStart"
                android:centerColor="?attr/cDangerEnd"
                android:endColor="?attr/cDangerStart" />
            <corners android:radius="30dp" />
            <stroke android:width="1.6dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item android:top="6dp" android:bottom="32dp" android:left="14dp" android:right="14dp">
        <shape>
            <gradient android:angle="270"
                android:startColor="#5EFFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
