<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape>
                <gradient android:type="radial" android:gradientRadius="60dp"
                    android:startColor="?attr/cHaloStrong" android:endColor="#00000000" />
                <corners android:radius="6dp" />
            </shape></item>
            <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="?attr/cDialEnd"
                        android:centerColor="?attr/cButtonEnd"
                        android:endColor="?attr/cDialStart" />
                    <corners android:radius="4dp" />
                    <stroke android:width="2.5dp" android:color="?attr/cAccent2" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape>
                <gradient android:type="radial" android:gradientRadius="60dp"
                    android:startColor="?attr/cHalo" android:endColor="#00000000" />
                <corners android:radius="6dp" />
            </shape></item>
            <!-- Plaque -->
            <item android:top="4dp" android:bottom="5dp" android:left="4dp" android:right="4dp">
                <shape>
                    <gradient android:angle="90"
                        android:startColor="?attr/cDialStart"
                        android:centerColor="?attr/cButtonStart"
                        android:endColor="?attr/cDialEnd" />
                    <corners android:radius="4dp" />
                    <stroke android:width="1.4dp" android:color="?attr/cNeonDim" />
                </shape>
            </item>
            <!-- Double liseré HUD -->
            <item android:top="8dp" android:bottom="9dp" android:left="8dp" android:right="8dp">
                <shape>
                    <stroke android:width="1dp" android:color="?attr/cHaloStrong" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
            <!-- Barre lumineuse supérieure -->
            <item android:top="4dp" android:bottom="42dp" android:left="4dp" android:right="4dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#3EFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
