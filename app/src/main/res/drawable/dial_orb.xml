<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- Halo intensifié -->
            <item><shape>
                <gradient android:type="radial" android:gradientRadius="70dp"
                    android:startColor="?attr/cHaloStrong" android:endColor="#00000000" />
                <corners android:radius="40dp" />
            </shape></item>
            <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#0E2A3C" android:endColor="#030608" />
                    <corners android:radius="36dp" />
                    <stroke android:width="2.5dp" android:color="?attr/cNeon" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Anneau de lueur externe, en trois couches dégressives -->
            <item><shape>
                <corners android:radius="40dp" />
                <stroke android:width="6dp" android:color="?attr/cHalo" />
            </shape></item>
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape>
                    <corners android:radius="38dp" />
                    <stroke android:width="3dp" android:color="?attr/cHaloStrong" />
                </shape>
            </item>
            <!-- Corps de verre noir -->
            <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
                <shape>
                    <gradient android:angle="90"
                        android:startColor="#02040A"
                        android:centerColor="#071320"
                        android:endColor="#0C2233" />
                    <corners android:radius="36dp" />
                    <stroke android:width="2dp" android:color="?attr/cNeon" />
                </shape>
            </item>
            <!-- Reflet supérieur brillant -->
            <item android:top="6dp" android:bottom="34dp" android:left="10dp" android:right="10dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#4DFFFFFF"
                        android:centerColor="#12FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="30dp" />
                </shape>
            </item>
            <!-- Liseré interne fin -->
            <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
                <shape>
                    <corners android:radius="34dp" />
                    <stroke android:width="1dp" android:color="#26FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
