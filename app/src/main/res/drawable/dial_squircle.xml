<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape>
                <gradient android:type="radial" android:gradientRadius="62dp"
                    android:startColor="?attr/cHaloStrong" android:endColor="#00000000" />
                <corners android:radius="30dp" />
            </shape></item>
            <item android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="?attr/cDialEnd"
                        android:centerColor="?attr/cButtonEnd"
                        android:endColor="?attr/cDialStart" />
                    <corners android:radius="24dp" />
                    <stroke android:width="2.5dp" android:color="?attr/cAccent2" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape>
                <gradient android:type="radial" android:gradientRadius="62dp"
                    android:startColor="?attr/cHalo" android:endColor="#00000000" />
                <corners android:radius="30dp" />
            </shape></item>
            <!-- Ombre sous la tuile -->
            <item android:top="8dp" android:bottom="3dp" android:left="5dp" android:right="5dp">
                <shape>
                    <solid android:color="#80000000" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item android:top="5dp" android:bottom="6dp" android:left="5dp" android:right="5dp">
                <shape>
                    <gradient android:angle="90"
                        android:startColor="?attr/cDialStart"
                        android:centerColor="?attr/cButtonStart"
                        android:endColor="?attr/cDialEnd" />
                    <corners android:radius="24dp" />
                    <stroke android:width="1.6dp" android:color="?attr/cNeonDim" />
                </shape>
            </item>
            <!-- Reflet de verre en haut -->
            <item android:top="6dp" android:bottom="32dp" android:left="9dp" android:right="9dp">
                <shape>
                    <gradient android:angle="270"
                        android:startColor="#55FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <!-- Liseré interne -->
            <item android:top="8dp" android:bottom="9dp" android:left="8dp" android:right="8dp">
                <shape>
                    <stroke android:width="1dp" android:color="#1AFFFFFF" />
                    <corners android:radius="19dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
