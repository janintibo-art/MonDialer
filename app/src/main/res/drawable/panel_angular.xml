<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape>
        <corners android:topLeftRadius="18dp" android:topRightRadius="3dp"
            android:bottomLeftRadius="3dp" android:bottomRightRadius="18dp" />
        <stroke android:width="4dp" android:color="?attr/cHalo" />
    </shape></item>
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape>
            <gradient android:angle="90"
                android:startColor="#02040A"
                android:centerColor="#050F1A"
                android:endColor="#081824" />
            <corners android:topLeftRadius="16dp" android:topRightRadius="3dp"
                android:bottomLeftRadius="3dp" android:bottomRightRadius="16dp" />
            <stroke android:width="1.6dp" android:color="?attr/cNeon" />
        </shape>
    </item>
    <item android:top="3dp" android:bottom="30dp" android:left="6dp" android:right="6dp">
        <shape>
            <gradient android:angle="270"
                android:startColor="#2EFFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
