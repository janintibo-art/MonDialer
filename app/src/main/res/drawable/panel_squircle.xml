<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp"><shape>
        <solid android:color="#88000000" /><corners android:radius="12dp" />
    </shape></item>
    <item android:bottom="4dp"><shape>
        <gradient android:angle="90"
            android:startColor="?attr/cPanelStart"
            android:centerColor="?attr/cButtonStart"
            android:endColor="?attr/cPanelEnd" />
        <corners android:radius="12dp" />
        <stroke android:width="1.5dp" android:color="?attr/cNeonDim" />
    </shape></item>
    <item android:bottom="4dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape>
            <gradient android:angle="270"
                android:startColor="#34FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</layer-list>
