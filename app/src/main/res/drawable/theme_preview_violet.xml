<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape>
            <solid android:color="#80000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape>
            <gradient android:angle="45"
                android:startColor="#1B0A36"
                android:centerColor="#8A4DFF"
                android:endColor="#FF3DAA" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item android:bottom="30dp" android:left="10dp" android:right="10dp">
        <shape>
            <gradient android:angle="270"
                android:startColor="#55FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
