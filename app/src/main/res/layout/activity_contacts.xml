<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            style="@style/NeonTitle"
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_band"
            android:gravity="center"
            android:textSize="18sp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/panelBg"
                android:padding="12dp"
                android:inputType="text" />

            <Button
                android:id="@+id/btnNewContact"
                style="@style/ActionBtn"
                android:layout_width="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="18sp"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- La liste occupe l'espace restant ; le poids doit rester
                 sur l'enfant direct du LinearLayout, pas sur la ListView. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginTop="8dp">

                <ListView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:scrollbars="none" />

                <include layout="@layout/empty_state" />
            </FrameLayout>

            <!-- Index alphabétique tactile -->
            <LinearLayout
                android:id="@+id/indexBar"
                android:layout_width="26dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lettre en surimpression pendant le glissement -->
    <TextView
        android:id="@+id/letterOverlay"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="center"
        android:background="?attr/panelBg"
        android:gravity="center"
        android:textColor="?attr/cNeon"
        android:textSize="44sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
