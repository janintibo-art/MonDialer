<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <TextView
            style="@style/NeonTitle"
            android:id="@+id/txtEditTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="18sp"
            android:paddingBottom="12dp" />

        <ImageView
            android:id="@+id/imgPhoto"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/panel_round"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:text="@string/tap_photo" />

        <EditText
            android:id="@+id/editName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_round"
            android:padding="12dp"
            android:inputType="textPersonName|textCapWords"
            android:hint="@string/hint_name" />

        <EditText
            android:id="@+id/editPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_round"
            android:padding="12dp"
            android:inputType="phone"
            android:hint="@string/hint_phone" />

        <EditText
            android:id="@+id/editEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_round"
            android:padding="12dp"
            android:inputType="textEmailAddress"
            android:hint="@string/hint_email" />

        <EditText
            android:id="@+id/editAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/panel_round"
            android:padding="12dp"
            android:inputType="textPostalAddress|textMultiLine"
            android:maxLines="3"
            android:hint="@string/hint_address" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_call"
            android:stateListAnimator="@animator/press"
            android:textColor="@color/bg_deep"
            android:textStyle="bold"
            android:text="@string/save_contact" />

        <Button
            android:id="@+id/btnSystemEdit"
            style="@style/ActionBtn"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:text="@string/open_system_editor" />
    </LinearLayout>
</ScrollView>
