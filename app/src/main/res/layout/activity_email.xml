<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/NeonTitle"
        android:background="@drawable/header_band"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/email_title"
            android:textSize="18sp"
            android:paddingBottom="10dp" />

        <!-- Compte expéditeur : un appui permet d'en changer -->
        <TextView
            android:id="@+id/txtFrom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/panelBg"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="?attr/cNeon"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/emailTo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/panelBg"
            android:padding="12dp"
            android:inputType="textEmailAddress"
            android:hint="@string/email_to" />

        <EditText
            android:id="@+id/emailSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/panelBg"
            android:padding="12dp"
            android:inputType="textCapSentences"
            android:hint="@string/email_subject" />

        <EditText
            android:id="@+id/emailBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/panelBg"
            android:padding="12dp"
            android:inputType="textCapSentences|textMultiLine|textAutoCorrect"
            android:minLines="6"
            android:gravity="top"
            android:hint="@string/email_body" />

        <TextView
            android:id="@+id/emailAttachChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/panelBg"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            android:textColor="?attr/cNeon"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button android:id="@+id/btnEmailAttach" style="@style/ActionBtn"
                android:layout_width="0dp" android:layout_weight="1"
                android:text="@string/email_attach" />
            <Button android:id="@+id/btnEmailAi" style="@style/ActionBtn"
                android:layout_width="0dp" android:layout_weight="1"
                android:text="@string/ai_button_long" />
            <Button android:id="@+id/btnEmailSettings" style="@style/ActionBtn"
                android:layout_width="0dp" android:layout_weight="1"
                android:text="@string/mail_accounts_btn" />
        </LinearLayout>

        <Button
            android:id="@+id/btnEmailSend"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:background="?attr/callBg"
            android:stateListAnimator="@animator/press"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="@string/email_send" />
    </LinearLayout>
</ScrollView>
