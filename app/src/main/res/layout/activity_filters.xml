<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/NeonTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/filters_title"
            android:textSize="18sp"
            android:paddingBottom="12dp" />

        <Switch android:id="@+id/swHidden"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:text="@string/block_hidden" />

        <Switch android:id="@+id/swInternational"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:text="@string/block_international" />

        <Switch android:id="@+id/swNeighbors"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:text="@string/block_neighbors" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">

            <EditText android:id="@+id/editMyNumber"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:inputType="phone"
                android:background="@drawable/panel_round" android:padding="12dp"
                android:hint="@string/my_number_hint" />

            <Button android:id="@+id/btnSaveMy" style="@style/ActionBtn"
                android:layout_width="wrap_content" android:paddingStart="18dp"
                android:paddingEnd="18dp" android:text="@string/save" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:textStyle="bold"
            android:textColor="@color/neon" android:text="@string/predefined_lists" />

        <LinearLayout
            android:id="@+id/listsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/panel_round"
            android:padding="8dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:textStyle="bold"
            android:textColor="@color/neon" android:text="@string/blocked_numbers" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText android:id="@+id/editAddNumber"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:inputType="phone"
                android:background="@drawable/panel_round" android:padding="12dp"
                android:layout_marginTop="6dp"
                android:hint="@string/add_number_hint" />

            <Button android:id="@+id/btnAddNumber" style="@style/ActionBtn"
                android:layout_width="wrap_content" android:paddingStart="20dp"
                android:paddingEnd="20dp" android:textSize="18sp" android:text="@string/add" />
        </LinearLayout>

        <ListView android:id="@+id/listNumbers"
            android:layout_width="match_parent" android:layout_height="180dp"
            android:background="@drawable/panel_round" android:layout_marginTop="6dp"
            android:divider="@color/neon_dim" android:dividerHeight="0.5dp" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:textStyle="bold"
            android:textColor="@color/neon" android:text="@string/blocked_prefixes" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText android:id="@+id/editAddPrefix"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:inputType="phone"
                android:background="@drawable/panel_round" android:padding="12dp"
                android:layout_marginTop="6dp"
                android:hint="@string/add_prefix_hint" />

            <Button android:id="@+id/btnAddPrefix" style="@style/ActionBtn"
                android:layout_width="wrap_content" android:paddingStart="20dp"
                android:paddingEnd="20dp" android:textSize="18sp" android:text="@string/add" />
        </LinearLayout>

        <ListView android:id="@+id/listPrefixes"
            android:layout_width="match_parent" android:layout_height="180dp"
            android:background="@drawable/panel_round" android:layout_marginTop="6dp"
            android:divider="@color/neon_dim" android:dividerHeight="0.5dp" />
    </LinearLayout>
</ScrollView>
