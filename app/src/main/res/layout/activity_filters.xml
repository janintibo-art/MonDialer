<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/NeonTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/filters_title"
            android:textSize="18sp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btnBlockedLog" style="@style/ActionBtn"
                android:layout_width="0dp" android:layout_weight="1.4"
                android:text="@string/blocked_log_btn" />
            <Button android:id="@+id/btnExport" style="@style/ActionBtn"
                android:layout_width="0dp" android:layout_weight="1"
                android:text="@string/export" />
            <Button android:id="@+id/btnImport" style="@style/ActionBtn"
                android:layout_width="0dp" android:layout_weight="1"
                android:text="@string/import_btn" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/theme_studio_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="5dp"
            android:text="@string/theme_studio_subtitle"
            android:textColor="?attr/cTextDim"
            android:textSize="12sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="5"
            android:useDefaultMargins="false">

            <TextView
                android:id="@+id/themeCyan"
                style="@style/ThemeCard"
                android:background="@drawable/theme_preview_cyan"
                android:text="@string/theme_cyber_ocean" />

            <TextView
                android:id="@+id/themeViolet"
                style="@style/ThemeCard"
                android:background="@drawable/theme_preview_violet"
                android:text="@string/theme_synthwave" />

            <TextView
                android:id="@+id/themeGreen"
                style="@style/ThemeCard"
                android:background="@drawable/theme_preview_green"
                android:text="@string/theme_toxic_punk" />

            <TextView
                android:id="@+id/themeOrange"
                style="@style/ThemeCard"
                android:background="@drawable/theme_preview_orange"
                android:text="@string/theme_solar_flare" />

            <TextView
                android:id="@+id/themeRose"
                style="@style/ThemeCard"
                android:background="@drawable/theme_preview_rose"
                android:text="@string/theme_candy_pulse" />

            <TextView
                android:id="@+id/themeRouge"
                style="@style/ThemeCard"
                android:background="@drawable/theme_preview_rouge"
                android:text="@string/theme_crimson_ice" />

            <TextView
                android:id="@+id/themeOr"
                style="@style/ThemeCard"
                android:background="@drawable/theme_preview_or"
                android:text="@string/theme_royal_gold" />

            <TextView
                android:id="@+id/themeGraphite"
                style="@style/ThemeCard"
                android:background="@drawable/theme_preview_graphite"
                android:text="@string/theme_obsidian_pro" />

            <TextView
                android:id="@+id/themeArdoise"
                style="@style/ThemeCard"
                android:background="@drawable/theme_preview_ardoise"
                android:text="@string/theme_ardoise_nuit" />
            <TextView
                android:id="@+id/themeCustom"
                style="@style/ThemeCard"
                android:background="@drawable/theme_preview_custom"
                android:text="@string/theme_custom" />

        </GridLayout>

        <Switch android:id="@+id/swNotifyBlocked"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:text="@string/notify_blocked" />

        <Switch android:id="@+id/swSilent"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:text="@string/silent_mode" />

        <Button android:id="@+id/btnLists" style="@style/ActionBtn"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:text="@string/lists_btn" />

        <Switch android:id="@+id/swUnknown"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:text="@string/block_unknown" />

        <Switch android:id="@+id/swAllowOnly"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:text="@string/allow_only" />

        <Switch android:id="@+id/swAllowContacts"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:text="@string/allow_contacts" />

        <Switch android:id="@+id/swHidden"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:text="@string/block_hidden" />

        <Switch android:id="@+id/swInternational"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:text="@string/block_international" />

        <Switch android:id="@+id/swNeighbors"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="8dp" android:text="@string/block_neighbors" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">

            <EditText android:id="@+id/editMyNumber"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:inputType="phone"
                android:background="?attr/panelBg" android:padding="12dp"
                android:hint="@string/my_number_hint" />

            <Button android:id="@+id/btnSaveMy" style="@style/ActionBtn"
                android:layout_width="wrap_content" android:paddingStart="18dp"
                android:paddingEnd="18dp" android:text="@string/save" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:textStyle="bold"
            android:textColor="?attr/cNeon" android:text="@string/predefined_lists" />

        <LinearLayout
            android:id="@+id/listsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/panelBg"
            android:padding="8dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:textStyle="bold"
            android:textColor="?attr/cNeon" android:text="@string/blocked_numbers" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText android:id="@+id/editAddNumber"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:inputType="phone"
                android:background="?attr/panelBg" android:padding="12dp"
                android:layout_marginTop="6dp"
                android:hint="@string/add_number_hint" />

            <Button android:id="@+id/btnAddNumber" style="@style/ActionBtn"
                android:layout_width="wrap_content" android:paddingStart="20dp"
                android:paddingEnd="20dp" android:textSize="18sp" android:text="@string/add" />
        </LinearLayout>

        <ListView android:id="@+id/listNumbers"
            android:layout_width="match_parent" android:layout_height="180dp"
            android:background="?attr/panelBg" android:layout_marginTop="6dp"
            android:divider="?attr/cNeonDim" android:dividerHeight="0.5dp" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:textStyle="bold"
            android:textColor="?attr/cNeon" android:text="@string/blocked_prefixes" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText android:id="@+id/editAddPrefix"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:inputType="phone"
                android:background="?attr/panelBg" android:padding="12dp"
                android:layout_marginTop="6dp"
                android:hint="@string/add_prefix_hint" />

            <Button android:id="@+id/btnAddPrefix" style="@style/ActionBtn"
                android:layout_width="wrap_content" android:paddingStart="20dp"
                android:paddingEnd="20dp" android:textSize="18sp" android:text="@string/add" />
        </LinearLayout>

        <ListView android:id="@+id/listPrefixes"
            android:layout_width="match_parent" android:layout_height="180dp"
            android:background="?attr/panelBg" android:layout_marginTop="6dp"
            android:divider="?attr/cNeonDim" android:dividerHeight="0.5dp" />
    </LinearLayout>
</ScrollView>
