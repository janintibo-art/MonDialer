<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        style="@style/NeonTitle"
        android:background="@drawable/header_band"
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/txtKind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/panelBg"
            android:padding="12dp"
            android:inputType="phone"
            android:hint="@string/add_number_hint" />

        <Button
            android:id="@+id/btnAdd"
            style="@style/ActionBtn"
            android:layout_width="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textSize="18sp"
            android:text="@string/add" />
    </LinearLayout>

    <Button
        android:id="@+id/btnFromContacts"
        style="@style/ActionBtn"
        android:layout_width="match_parent"
        android:layout_marginTop="6dp"
        android:text="@string/list_from_contacts" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:divider="?attr/cNeonDim"
        android:dividerHeight="0.5dp" />
</LinearLayout>
