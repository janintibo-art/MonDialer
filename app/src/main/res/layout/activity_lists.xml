<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        style="@style/NeonTitle"
        android:background="@drawable/header_band"
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="18sp"
        android:paddingBottom="8dp" />

    <Button
        android:id="@+id/btnNewList"
        style="@style/ActionBtn"
        android:layout_width="match_parent"
        android:text="@string/list_new" />

    <TextView
        android:id="@+id/txtHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="?attr/cNeonDim"
        android:dividerHeight="0.5dp" />

        <include layout="@layout/empty_state" />
    </FrameLayout>
</LinearLayout>
