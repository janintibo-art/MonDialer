<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        style="@style/NeonTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/header"
        android:textSize="22sp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btnContacts" style="@style/ActionBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/contacts" />
        <Button android:id="@+id/btnLog" style="@style/ActionBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/call_log" />
        <Button android:id="@+id/btnFilters" style="@style/ActionBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/filters" />
        <Button android:id="@+id/btnDefault" style="@style/ActionBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/set_default" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btnSms" style="@style/ActionBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/sms" />
        <Button android:id="@+id/btnVoicemail" style="@style/ActionBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/voicemail" />
        <Button android:id="@+id/btnVideo" style="@style/ActionBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/video_call" />
    </LinearLayout>

    <EditText
        android:id="@+id/editNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/panel_round"
        android:padding="14dp"
        android:inputType="phone"
        android:textSize="30sp"
        android:textColor="?attr/cNeon"
        android:shadowColor="?attr/cNeon"
        android:shadowRadius="14"
        android:shadowDx="0"
        android:shadowDy="0"
        android:gravity="center"
        android:hint="•••" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/favRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/suggestRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:columnCount="3"
        android:rowCount="4">

        <Button android:id="@+id/btn1" style="@style/Dialpad" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/Dialpad" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/Dialpad" android:text="3" />
        <Button android:id="@+id/btn4" style="@style/Dialpad" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/Dialpad" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/Dialpad" android:text="6" />
        <Button android:id="@+id/btn7" style="@style/Dialpad" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/Dialpad" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/Dialpad" android:text="9" />
        <Button android:id="@+id/btnStar" style="@style/Dialpad" android:text="*" />
        <Button android:id="@+id/btn0" style="@style/Dialpad" android:text="0" />
        <Button android:id="@+id/btnHash" style="@style/Dialpad" android:text="#" />
    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCall"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="2"
            android:layout_margin="4dp"
            android:background="@drawable/btn_call"
            android:stateListAnimator="@animator/press"
            android:textColor="@color/bg_deep"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:text="@string/call" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_action"
            android:stateListAnimator="@animator/press"
            android:textColor="?attr/cNeon"
            android:textSize="22sp"
            android:shadowColor="?attr/cNeon"
            android:shadowRadius="10"
            android:shadowDx="0"
            android:shadowDy="0"
            android:text="@string/delete" />
    </LinearLayout>
</LinearLayout>
