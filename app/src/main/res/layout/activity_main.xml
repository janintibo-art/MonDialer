<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        style="@style/NeonTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/header"
        android:textSize="26sp"
        android:letterSpacing="0.18"
        android:paddingTop="8dp"
        android:paddingBottom="10dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/divider_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btnContacts" style="@style/ActionBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/contacts" 
            android:drawableTop="@drawable/ic_contact"
            android:drawablePadding="3dp"
            android:maxLines="1"
            android:ellipsize="none"
            android:textSize="9sp"
        />
        <Button android:id="@+id/btnLog" style="@style/ActionBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/call_log" 
            android:drawableTop="@drawable/ic_clock"
            android:drawablePadding="3dp"
            android:maxLines="1"
            android:ellipsize="none"
            android:textSize="9sp"
        />
        <Button android:id="@+id/btnFilters" style="@style/ActionBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/filters" 
            android:drawableTop="@drawable/ic_filter"
            android:drawablePadding="3dp"
            android:maxLines="1"
            android:ellipsize="none"
            android:textSize="9sp"
        />
        <Button android:id="@+id/btnDefault" style="@style/ActionBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/set_default" 
            android:drawableTop="@drawable/ic_star"
            android:drawablePadding="3dp"
            android:maxLines="1"
            android:ellipsize="none"
            android:textSize="9sp"
        />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btnSms" style="@style/ActionBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/sms" 
            android:drawableTop="@drawable/ic_chat"
            android:drawablePadding="3dp"
            android:maxLines="1"
            android:ellipsize="none"
            android:textSize="9sp"
        />
        <Button android:id="@+id/btnVoicemail" style="@style/ActionBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/voicemail" 
            android:drawableTop="@drawable/ic_voicemail"
            android:drawablePadding="3dp"
            android:maxLines="1"
            android:ellipsize="none"
            android:textSize="9sp"
        />
        <Button android:id="@+id/btnVideo" style="@style/ActionBtn"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/video_call" 
            android:drawableTop="@drawable/ic_video"
            android:drawablePadding="3dp"
            android:maxLines="1"
            android:ellipsize="none"
            android:textSize="9sp"
        />
    </LinearLayout>

    <EditText
        android:id="@+id/editNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?attr/panelBg"
        android:padding="14dp"
        android:inputType="phone"
        android:textSize="30sp"
        android:textColor="?attr/cNeon"
        android:shadowColor="?attr/cNeon"
        android:shadowRadius="14"
        android:shadowDx="0"
        android:shadowDy="0"
        android:gravity="center"
        android:hint="•••" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/favRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/suggestRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:columnCount="3"
        android:rowCount="4">

        <Button android:id="@+id/btn1" style="@style/Dialpad" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/Dialpad" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/Dialpad" android:text="3" />
        <Button android:id="@+id/btn4" style="@style/Dialpad" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/Dialpad" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/Dialpad" android:text="6" />
        <Button android:id="@+id/btn7" style="@style/Dialpad" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/Dialpad" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/Dialpad" android:text="9" />
        <Button android:id="@+id/btnStar" style="@style/Dialpad" android:text="*" />
        <Button android:id="@+id/btn0" style="@style/Dialpad" android:text="0" />
        <Button android:id="@+id/btnHash" style="@style/Dialpad" android:text="#" />
    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCall"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="2"
            android:layout_margin="4dp"
            android:background="?attr/callBg"
            android:stateListAnimator="@animator/press"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp"
            android:letterSpacing="0.12"
            android:drawableStart="@drawable/ic_phone_white"
            android:drawablePadding="10dp"
            android:paddingStart="24dp"
            android:shadowColor="#B3000000"
            android:shadowRadius="6"
            android:shadowDx="0"
            android:shadowDy="1"
            android:text="@string/call" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="?attr/actionBg"
            android:stateListAnimator="@animator/press"
            android:drawableStart="@drawable/ic_backspace"
            android:paddingStart="26dp"
            android:text="" />
    </LinearLayout>
</LinearLayout>
