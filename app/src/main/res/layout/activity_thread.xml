<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <EditText
        android:id="@+id/editTo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/panelBg"
        android:padding="12dp"
        android:inputType="phone"
        android:hint="@string/to_hint" />

    <ListView
        android:id="@+id/listMsgs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:stackFromBottom="true"
        android:transcriptMode="normal" />

    <TextView
        android:id="@+id/txtAttach"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/panelBg"
        android:padding="10dp"
        android:layout_marginTop="6dp"
        android:textColor="?attr/cNeon"
        android:visibility="gone" />

    <!-- Rangée d'outils, compacte, au-dessus de la zone de saisie -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEmoji"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:paddingStart="0dp" android:paddingEnd="0dp"
            android:paddingTop="8dp" android:paddingBottom="8dp"
            android:textSize="15sp"
            android:text="😊" />

        <Button
            android:id="@+id/btnGif"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:paddingStart="0dp" android:paddingEnd="0dp"
            android:paddingTop="8dp" android:paddingBottom="8dp"
            android:textSize="12sp"
            android:text="@string/gif_btn" />

        <Button
            android:id="@+id/btnAi"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:paddingStart="0dp" android:paddingEnd="0dp"
            android:paddingTop="8dp" android:paddingBottom="8dp"
            android:textSize="15sp"
            android:text="@string/ai_button" />

        <Button
            android:id="@+id/btnAttach"
            style="@style/ActionBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:paddingStart="0dp" android:paddingEnd="0dp"
            android:paddingTop="8dp" android:paddingBottom="8dp"
            android:textSize="15sp"
            android:text="📎" />
    </LinearLayout>

    <!-- Zone de saisie : une vraie bulle large, dans la continuité du fil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="bottom">

        <com.example.mondialer.RichEditText
            android:id="@+id/editBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/bubbleOutBg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="1"
            android:maxLines="6"
            android:textSize="16sp"
            android:gravity="top|start"
            android:hint="@string/message_hint" />

        <Button
            android:id="@+id/btnSend"
            style="@style/ActionBtn"
            android:layout_width="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textSize="17sp"
            android:text="@string/send" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emojiPanel"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:orientation="vertical"
        android:background="?attr/panelBg"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <GridView
            android:id="@+id/emojiGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="8" />
    </LinearLayout>
</LinearLayout>
