<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Dialpad">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">?attr/cNeon</item>
        <item name="android:background">@drawable/btn_dial</item>
        <item name="android:stateListAnimator">@animator/press</item>
        <item name="android:hapticFeedbackEnabled">true</item>
        <item name="android:shadowColor">?attr/cNeon</item>
        <item name="android:shadowRadius">12</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
    </style>

    <style name="DialpadMini" parent="Dialpad">
        <item name="android:textSize">18sp</item>
        <item name="android:layout_margin">3dp</item>
    </style>

    <style name="ActionBtn">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/cNeon</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/btn_action</item>
        <item name="android:stateListAnimator">@animator/press</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:shadowColor">?attr/cNeon</item>
        <item name="android:shadowRadius">8</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
    </style>

    <style name="NeonTitle">
        <item name="android:textColor">?attr/cNeon</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.4</item>
        <item name="android:shadowColor">?attr/cNeon</item>
        <item name="android:shadowRadius">18</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
    </style>
</resources>
