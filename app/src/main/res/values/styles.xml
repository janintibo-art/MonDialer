<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Touche circulaire néon du clavier -->
    <style name="Dialpad">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/neon</item>
        <item name="android:background">@drawable/btn_dial</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Bouton d'action rectangulaire néon -->
    <style name="ActionBtn">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/neon</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/btn_action</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
</resources>
