<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:colorAccent">?attr/cNeon</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:editTextColor">@color/text_main</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <!-- Palette cyan (défaut) -->
        <item name="cNeon">#00E5FF</item>
        <item name="cNeonDim">#00B8D4</item>
        <item name="cHalo">#3300E5FF</item>
        <item name="cHaloStrong">#8000E5FF</item>
    </style>

    <style name="AppTheme.Violet">
        <item name="cNeon">#C77DFF</item>
        <item name="cNeonDim">#9D4EDD</item>
        <item name="cHalo">#33C77DFF</item>
        <item name="cHaloStrong">#80C77DFF</item>
    </style>

    <style name="AppTheme.Green">
        <item name="cNeon">#00FF66</item>
        <item name="cNeonDim">#00CC52</item>
        <item name="cHalo">#3300FF66</item>
        <item name="cHaloStrong">#8000FF66</item>
    </style>

    <style name="AppTheme.Orange">
        <item name="cNeon">#FF9E00</item>
        <item name="cNeonDim">#E08700</item>
        <item name="cHalo">#33FF9E00</item>
        <item name="cHaloStrong">#80FF9E00</item>
    </style>
    <style name="AppTheme.Rose">
        <item name="cNeon">#FF4FD8</item>
        <item name="cNeonDim">#D633B0</item>
        <item name="cHalo">#33FF4FD8</item>
        <item name="cHaloStrong">#80FF4FD8</item>
    </style>

    <style name="AppTheme.Rouge">
        <item name="cNeon">#FF3355</item>
        <item name="cNeonDim">#D91F42</item>
        <item name="cHalo">#33FF3355</item>
        <item name="cHaloStrong">#80FF3355</item>
    </style>

    <style name="AppTheme.Or">
        <item name="cNeon">#FFD24A</item>
        <item name="cNeonDim">#E0B02E</item>
        <item name="cHalo">#33FFD24A</item>
        <item name="cHaloStrong">#80FFD24A</item>
    </style>
</resources>
